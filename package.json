{
  "name": "only-movie",
  "version": "3.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "db:migrate": "pnpm dlx --package=netlify-cli@27 netlify database migrations apply",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "LIVE=1 playwright test e2e/live.spec.ts",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts --project=chromium",
    "demo-gif": "DEMO=1 playwright test e2e/demo.spec.ts --project=chromium"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource/black-han-sans": "^5.3.0",
    "@fontsource/gothic-a1": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.1.0",
    "@netlify/identity": "^2.0.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@netlify/database-dev": "^1.0.1",
    "@netlify/vite-plugin": "^3.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "gifenc": "^1.0.3",
    "jsdom": "^30.1.3",
    "oxlint": "^1.91.0",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
